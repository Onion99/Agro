+template <typename Symbol>
+void LookupOptionalSymbol(SharedLibrary& lib, const char* symbol_name,
+                          Symbol& symbol) {
+  auto symbol_or = lib.LookupSymbol<Symbol>(symbol_name);
+  if (symbol_or.HasValue()) {
+    symbol = *symbol_or;
+    return;
+  }
+  ABSL_VLOG(1) << "Optional sampler symbol is unavailable: " << symbol_name
+               << ": " << symbol_or.Error();
+}
